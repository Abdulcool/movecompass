{
  "expo": {
    "name": "MoveCompass",
    "slug": "movecompass",
    "scheme": "movecompass",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-image",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MoveCompass to guide your exercise on this device.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.cccare.movecompass"
    },
    "android": {
      "package": "ca.cccare.movecompass"
    }
  }
}
